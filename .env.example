# ODA Hotel Resort - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive data!

# =====================================
# PRODUCTION / DEPLOYMENT SETTINGS
# =====================================

# Node.js Environment
NODE_ENV=production

# =====================================
# SUPABASE (Database & Authentication)
# =====================================

# Your Supabase project URL
# Format: https://[project-name].supabase.co
SUPABASE_URL=https://your-project-name.supabase.co

# Your Supabase anonymous API key
# Found in: Supabase Dashboard → Settings → API
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Vite needs these for client-side
VITE_SUPABASE_URL=https://your-project-name.supabase.co
VITE_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service role key (for admin operations)
# ⚠️ KEEP THIS SECRET! Never expose on client!
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================
# DATABASE CONNECTION (Optional)
# =====================================

# If using direct database connection
# DATABASE_URL=postgresql://user:password@host:port/database
# DATABASE_URL_SHADOW=postgresql://user:password@shadow-host:port/shadow-db

# =====================================
# EMAIL SERVICE (Resend)
# =====================================

# Resend.dev API key for sending emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# From email address for transactional emails
# Must be verified in Resend dashboard
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =====================================
# PAYMENT PROCESSING (Chapa)
# =====================================

# Chapa payment gateway API key
# Get from: https://chapa.co/dashboard/settings/keys
CHAPA_API_KEY=CHASECK_TEST_xxxxxxxx...

# Webhook secret for payment confirmations
CHAPA_WEBHOOK_SECRET=your-webhook-secret

# =====================================
# ADMIN SETTINGS
# =====================================

# Admin login credentials (optional, can use Supabase auth)
# ADMIN_EMAIL=admin@odaresort.com
# ADMIN_PASSWORD=your_secure_password

# Admin session timeout (in minutes)
# ADMIN_SESSION_TIMEOUT=30

# =====================================
# CORS & SECURITY
# =====================================

# Allowed origins for CORS
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# Session secret key for encryption
# Generate with: openssl rand -base64 32
# SESSION_SECRET=your-base64-encoded-secret-key

# =====================================
# LOGGING & MONITORING
# =====================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Sentry error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# =====================================
# API KEYS & THIRD-PARTY SERVICES
# =====================================

# Google Analytics (optional)
# VITE_GA_ID=G-XXXXXXXXXX

# Cloudflare (if using CDN)
# CLOUDFLARE_API_KEY=your-api-key
# CLOUDFLARE_ZONE_ID=your-zone-id

# SMS Service (for bookings alerts)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# =====================================
# FEATURE FLAGS
# =====================================

# Enable/disable features
# ENABLE_BOOKINGS=true
# ENABLE_ONLINE_PAYMENTS=true
# ENABLE_MENU_ORDERING=false

# =====================================
# APPLICATION SETTINGS
# =====================================

# Port the application runs on (for cPanel)
PORT=3000

# Maximum file upload size (MB)
MAX_UPLOAD_SIZE=10

# Currency (for pricing)
# CURRENCY=ETB

# Timezone
# TZ=Africa/Addis_Ababa

# =====================================
# DEVELOPMENT SETTINGS (Usually kept in .env.local)
# =====================================

# Only uncomment if using locally
# VITE_API_URL=http://localhost:3000
# DEBUG=*

# =====================================
# HOW TO GET THESE VALUES
# =====================================

# SUPABASE_URL & SUPABASE_KEY:
#   1. Go to https://app.supabase.com
#   2. Select your project
#   3. Settings → API
#   4. Copy URL and anon public key

# RESEND_API_KEY:
#   1. Go to https://resend.com
#   2. Login to dashboard
#   3. Settings → API Keys
#   4. Create new key

# CHAPA_API_KEY:
#   1. Go to https://chapa.co
#   2. Login to dashboard
#   3. Settings → API Keys
#   4. Copy test or live key

# =====================================
# ⚠️ SECURITY NOTES
# =====================================

# 1. NEVER commit .env to git
#    Add ".env" to .gitignore

# 2. NEVER share your API keys
#    Regenerate immediately if exposed

# 3. Use strong passwords
#    Min 16 characters, mix of upper/lower/numbers/symbols

# 4. Rotate keys regularly
#    Every 90 days recommended

# 5. Use environment variables
#    Never hardcode secrets in code

# 6. For cPanel deployment:
#    Use cPanel's Environment Variables UI
#    Not a physical .env file

# =====================================
# VALIDATION CHECKLIST
# =====================================

# Before starting application:
# ✓ SUPABASE_URL is set
# ✓ SUPABASE_KEY is set
# ✓ VITE_SUPABASE_URL is set
# ✓ VITE_SUPABASE_KEY is set
# ✓ NODE_ENV is 'production'
# ✓ No quotes around values (unless needed)
# ✓ No trailing spaces
# ✓ .env file is in /home/sam/OdaHotelResort for local
# ✓ Variables are in cPanel for production

# =====================================
# USAGE EXAMPLES
# =====================================

# For sending emails:
# Uses: RESEND_API_KEY, RESEND_FROM_EMAIL

# For payments:
# Uses: CHAPA_API_KEY, CHAPA_WEBHOOK_SECRET

# For menu/bookings:
# Uses: SUPABASE_URL, SUPABASE_KEY

# For admin panel:
# Uses: Supabase authentication

# =====================================
